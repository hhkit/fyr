@article{bangaruSLANGDFastModular2023,
  title = {{{SLANG}}.{{D}}: {{Fast}}, {{Modular}} and {{Differentiable Shader Programming}}},
  shorttitle = {{{SLANG}}.{{D}}},
  author = {Bangaru, Sai Praveen and Wu, Lifan and Li, Tzu-Mao and Munkberg, Jacob and Bernstein, Gilbert and {Ragan-Kelley}, Jonathan and Durand, Fr{\'e}do and Lefohn, Aaron and He, Yong},
  year = 2023,
